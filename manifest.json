{
  "manifest_version": 3,
  "name": "Facebook Feed Filter",
  "version": "0.1.0",
  "description": "Hide sponsored posts and unfollowed-page suggestions in your Facebook feed behind translucent overlays. Editable rules and training queue.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["defaults.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
