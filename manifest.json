{
  "manifest_version": 3,
  "name": "Clickbait Filter",
  "version": "0.1.0",
  "description": "Hide clickbait videos on YouTube with translucent overlays.",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
